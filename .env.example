# Copy this file to .env and replace every change-me value before starting Compose.
DB_NAME=healthy
DB_USERNAME=healthy_app
DB_PASSWORD=change-me-database-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

REDIS_PASSWORD=change-me-redis-password

RABBITMQ_USERNAME=healthy_app
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# Use a long, random value in production. Do not reuse a password here.
JWT_SECRET=change-me-to-a-long-random-jwt-secret-at-least-64-characters

FLYWAY_BASELINE_ON_MIGRATE=false
WEB_PORT=8089
TZ=Asia/Shanghai

# Copy this file to .env and replace every change-me value before starting Compose.
# booking-service database
DB_NAME=healthy
DB_USERNAME=healthy_app
DB_PASSWORD=change-me-database-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

# doctor-service owns a separate database and should use a separately scoped account.
DOCTOR_DB_NAME=healthy_doctor
DOCTOR_DB_USERNAME=healthy_doctor_app
DOCTOR_DB_PASSWORD=change-me-doctor-database-password

# identity-service owns accounts and patient profiles in its own database.
IDENTITY_DB_NAME=healthy_identity
IDENTITY_DB_USERNAME=healthy_identity_app
IDENTITY_DB_PASSWORD=change-me-identity-database-password

REDIS_PASSWORD=change-me-redis-password

RABBITMQ_USERNAME=healthy_app
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# Use a long, random value in production. Do not reuse a password here.
JWT_SECRET=change-me-to-a-long-random-jwt-secret-at-least-64-characters

FLYWAY_BASELINE_ON_MIGRATE=false
WEB_PORT=8089
TZ=Asia/Shanghai
